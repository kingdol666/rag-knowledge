\newlabel{sec:system}{{3}{2}{System Architecture}{section.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Three services, one capability set}{2}{subsection.3.1}\protected@file@percent }
\newlabel{sec:sys-services}{{3.1}{2}{Three services, one capability set}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces System architecture. Three services partition responsibility --- the web layer owns knowledge-base and document CRUD, the FastAPI backend owns parsing, retrieval, graph and experience computation, and an ephemeral MinerU process does OCR. Every mutation travels one write path that updates all five storage layers inside a single logical transaction (\S  \ref {sec:sys-layers}); retrieval reads those layers directly, so search adds no load to the service tier. The same capability set is published twice: as REST endpoints for the human UI, and as 94 MCP tools for agents, so a procedure validated in one surface is executable in the other.}}{3}{figure.caption.13}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:arch}{{1}{3}{System architecture. Three services partition responsibility --- the web layer owns knowledge-base and document CRUD, the FastAPI backend owns parsing, retrieval, graph and experience computation, and an ephemeral MinerU process does OCR. Every mutation travels one write path that updates all five storage layers inside a single logical transaction (\S \ref {sec:sys-layers}); retrieval reads those layers directly, so search adds no load to the service tier. The same capability set is published twice: as REST endpoints for the human UI, and as 94 MCP tools for agents, so a procedure validated in one surface is executable in the other}{figure.caption.13}{}}
