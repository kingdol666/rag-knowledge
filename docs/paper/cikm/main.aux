\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Component ablation on BEIR SciFact (30 queries, official qrels), same query set as Table\nonbreakingspace \ref {tab:scifact}. Deployed variants use stage-2 $k{=}10$; ``deep'' variants re-rank a $k{=}40$ pool, because the deployed top-10 is already pre-filtered by the Stage-3 threshold (lowest returned score $0.379$), which makes a threshold sweep on the shallow pool a no-op --- a finding in itself.}}{8}{table.caption.23}\protected@file@percent }
\newlabel{tab:ablation}{{3}{8}{Component ablation on BEIR SciFact (30 queries, official qrels), same query set as Table~\ref {tab:scifact}. Deployed variants use stage-2 $k{=}10$; ``deep'' variants re-rank a $k{=}40$ pool, because the deployed top-10 is already pre-filtered by the Stage-3 threshold (lowest returned score $0.379$), which makes a threshold sweep on the shallow pool a no-op --- a finding in itself}{table.caption.23}{}}
