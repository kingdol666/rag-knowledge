"""Provenance audit: for every artefact the paper cites, does a producing script exist?

WHY THIS EXISTS
---------------
During revision it was discovered that `benchmark-web/backend/results/cikm/` and
`.../results/v4/` — the source of the paper's MAIN results table, FPR figure and
ablation table — have NO producer script anywhere in the repository. The results
that cannot be reproduced are the ones the paper led with, while the results it
treated as secondary are the only ones with a traceable producer.

This script re-derives that audit automatically so the finding is verifiable
rather than asserted, and so it cannot recur silently.

Run:  python provenance_audit.py
"""
from __future__ import annotations

import os
import re

ROOT = None
d = os.path.dirname(os.path.abspath(__file__))
for _ in range(8):
    if os.path.isdir(os.path.join(d, "benchmark-suite")):
        ROOT = d
        break
    d = os.path.dirname(d)
if ROOT is None:
    raise SystemExit("repository root not found")

SKIP = re.compile(r"node_modules|\\\.git\\|site-packages|\\\.venv\\|\.nuxt|\.output"
                  r"|src-tauri|chroma_db|neo4j_|\.mimosa|\.ui-audit")

CODE_EXT = (".py", ".js", ".mjs", ".cjs", ".ts", ".ps1", ".sh", ".bat")

# (artefact path, what the paper uses it for)
ARTEFACTS = [
    ("benchmark-suite/results/module_a_ingestion_r1.json", "Table 2 ingestion (in-house)"),
    ("benchmark-suite/results/module_a_std2_r1.json",      "Table 2 ingestion (standard)"),
    ("benchmark-suite/results/module_b_retrieval_r2.json", "Table 6 in-house retrieval"),
    ("benchmark-suite/results/module_b_std2_r2.json",      "Table 3 BEIR SciFact + SQuAD"),
    ("benchmark-suite/results/module_c_experience_r2.json","Table 7 experience"),
    ("benchmark-web/backend/results/cikm/cikm_summary.json","Table 4 MAIN + Figure 3 FPR + Table 5 ablation"),
    ("benchmark-web/backend/results/cikm/figure1_comparison.json", "Figure 3 source"),
    ("benchmark-web/backend/results/cikm/table1_main.tex",  "Table 4 pre-rendered"),
    ("benchmark-web/backend/results/cikm/table3_ablation.tex","Table 5 pre-rendered"),
    ("benchmark-web/backend/results/v4/benchmark_report.json","the p-values cited by R1"),
]

# Collect every line of code once, EXCLUDING this paper's own scaffolding — the
# question is whether the SYSTEM produced the artefact, not whether the paper
# cites it. (An earlier version of this script matched freeze_snapshot.py and
# reported 0 missing, which was wrong.)
SELF = os.path.join(ROOT, "docs", "paper", "cikm")
code_files = []
for base, _dirs, files in os.walk(ROOT):
    if SKIP.search(base) or base.startswith(SELF):
        continue
    for fn in files:
        if fn.endswith(CODE_EXT):
            p = os.path.join(base, fn)
            try:
                if os.path.getsize(p) < 3_000_000:
                    code_files.append(p)
            except OSError:
                pass


def producers(rel: str) -> list[str]:
    """Scripts that plausibly WRITE this artefact: they either name the file in an
    output context, or write into the directory that holds it."""
    name = os.path.basename(rel)
    stem = name.rsplit(".", 1)[0]
    outdir = os.path.dirname(rel)
    outdir_tail = outdir.split("/")[-1]          # e.g. "cikm", "results", "v4"
    found = []
    for p in code_files:
        try:
            txt = open(p, encoding="utf-8", errors="replace").read()
        except OSError:
            continue
        relcode = os.path.relpath(p, ROOT)
        # (a) names the exact artefact AND writes json/tex somewhere
        names_it = (name in txt) or (stem in txt)
        writes = bool(re.search(r"json\.dump|\.write_text|\.write\(|open\([^)]*['\"]w",
                                txt))
        # (b) writes into the artefact's own directory
        writes_dir = bool(re.search(r"['\"][^'\"]*%s[^'\"]*['\"]" % re.escape(outdir_tail),
                                    txt)) and writes
        # (c) a numbered benchmark step script inside the same tree
        is_step = bool(re.match(r"^benchmark-suite[\\/]scripts[\\/]\d\d_", relcode))
        if (names_it and writes) or writes_dir or (is_step and writes_dir):
            found.append(relcode)
    return found


print(f"scanned {len(code_files)} code files (excluding docs/paper/cikm/)\n")
print(f"{'artefact':<56} {'used for':<44} producer")
print("-" * 150)

findings = []
for rel, use in ARTEFACTS:
    hits = producers(rel)
    status = hits[0] if hits else "*** NONE — NOT REPRODUCIBLE ***"
    findings.append((rel, use, hits))
    print(f"{rel:<56} {use:<44} {status}")

print("\n" + "=" * 150)
missing = [f for f in findings if not f[2]]
print(f"artefacts with NO producer: {len(missing)}/{len(findings)}")
for rel, use, _ in missing:
    print(f"  - {rel}\n      used for: {use}")
